APP_ENV=production
# APP_PORT: definida no Módulo 06 (deploy). 30XX é inválido de propósito: o compose
# falha até a porta real ser preenchida no .env do servidor.
APP_PORT=30XX
APP_ENABLE_DOCS=false
DATABASE_PATH=/data/tecnico.db
MAX_BODY_BYTES=524288
RATE_LIMIT_PER_TOKEN_PER_HOUR=60
OPENCODE_GO_API_KEY=changeme
OPENCODE_GO_MODEL=mimo-v2.6-flash
OPENCODE_GO_TIMEOUT_SECONDS=60
# Enviado como reasoning_effort (ADR-026). Vazio = não enviar e usar o padrão do provedor.
OPENCODE_GO_REASONING_EFFORT=low
NOCODB_ENABLED=false
NOCODB_URL=https://nocodb.exemplo.invalid
NOCODB_TOKEN=changeme
NOCODB_TABLE_ID=changeme
NOCODB_RETRY_SECONDS=300
NTFY_ENABLED=false
NTFY_URL=https://ntfy.exemplo.invalid
NTFY_TOPIC=itc-infra
NTFY_TOKEN=changeme
NTFY_REPEAT_MINUTES=60
NTFY_FAILURE_THRESHOLD_PER_HOUR=5
TZ=America/Sao_Paulo
# Login do Bench (ADR-013). Vazios: a API sobe e o login responde 503 glpi_indisponivel.
# GLPI_URL interna (mesmo servidor ou rede do Docker): http:// para host público é recusado.
GLPI_URL=http://glpi.exemplo.invalid
GLPI_OAUTH_CLIENT_ID=
GLPI_OAUTH_CLIENT_SECRET=
GLPI_PERFIL_TECNICOS_ID=0
GLPI_TIMEOUT_SECONDS=10
# Chave do HMAC do usuário na auditoria e no limite: gere com `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
BENCH_LOGIN_HMAC_KEY=
# Vazia: login do Bench desligado (503). Nunca um valor fixo: ele viraria a chave real.
BENCH_SESSAO_HORAS=12
BENCH_LOGIN_FALHAS_USUARIO=5
BENCH_LOGIN_FALHAS_IP=20
# Cadastros do Bench (ADR-014, TA-ADR-027). Token de um usuário Viewer só na base "ITC Bench",
# diferente do NOCODB_TOKEN do espelho (Editor só na base dos relatórios). NOCODB_URL é a mesma.
# Vazios: GET /v1/bench/cadastros responde 503 cadastros_indisponivel.
NOCODB_CADASTROS_TOKEN=
NOCODB_TABELA_SERVIDORES=
NOCODB_TABELA_INSTALADORES=
NOCODB_TABELA_WIFI=
NOCODB_TABELA_UNIDADES=
NOCODB_CADASTROS_TIMEOUT_SECONDS=5
NOCODB_CADASTROS_TTL_SECONDS=60
# Chave do HMAC da versão (ETag); gere como a BENCH_LOGIN_HMAC_KEY. Vazia: chave aleatória por processo.
BENCH_CADASTROS_ETAG_KEY=
