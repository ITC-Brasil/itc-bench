APP_ENV=production
# APP_PORT: definida no Módulo 06 (deploy). 30XX é inválido de propósito: o compose
# falha até a porta real ser preenchida no .env do servidor.
APP_PORT=30XX
APP_ENABLE_DOCS=false
DATABASE_PATH=/data/tecnico.db
MAX_BODY_BYTES=524288
RATE_LIMIT_PER_TOKEN_PER_HOUR=60
OPENCODE_GO_API_KEY=changeme
OPENCODE_GO_MODEL=mimo-v2.6-flash
OPENCODE_GO_TIMEOUT_SECONDS=60
NOCODB_ENABLED=false
NOCODB_URL=https://nocodb.exemplo.invalid
NOCODB_TOKEN=changeme
NOCODB_TABLE_ID=changeme
NOCODB_RETRY_SECONDS=300
NTFY_ENABLED=false
NTFY_URL=https://ntfy.exemplo.invalid
NTFY_TOPIC=itc-infra
NTFY_TOKEN=changeme
NTFY_REPEAT_MINUTES=60
NTFY_FAILURE_THRESHOLD_PER_HOUR=5
TZ=America/Sao_Paulo
